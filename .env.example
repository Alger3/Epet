# Local development only. Never reuse these values outside a disposable local environment.
EPET_ENV=development
EPET_API_BASE_URL=http://127.0.0.1:8000

# Local service dependencies; the implementation may split these into service-specific examples.
EPET_DATABASE_URL=postgresql://epet:epet_local_only@127.0.0.1:5432/epet
EPET_REDIS_URL=redis://127.0.0.1:6379/0
EPET_OBJECT_ENDPOINT=http://127.0.0.1:9000
EPET_OBJECT_BUCKET=epet-development
EPET_OBJECT_ACCESS_KEY=local-development
EPET_OBJECT_SECRET_KEY=local-development-only

# Safe bootstrap defaults: use deterministic local assets until a Worker is configured.
EPET_USE_MOCK_WORKER=true
EPET_FORCE_TEMPLATE_ANIMATION=true
EPET_DISABLE_NEW_UPLOADS=false
EPET_DISABLE_NEW_GENERATIONS=false

# Production must override budgets and fail startup if they are missing.
EPET_DAILY_GPU_BUDGET_SECONDS=0
EPET_MAX_CONCURRENT_GENERATIONS=1
