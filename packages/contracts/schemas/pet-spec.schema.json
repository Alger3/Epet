{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.epet.invalid/v1/pet-spec.schema.json",
  "title": "Structured pet identity specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "species", "body_type", "primary_colors", "pattern", "ear_shape", "eye_color", "muzzle", "tail", "coat_length", "accessories", "uncertainties"],
  "properties": {
    "schema_version": { "const": 1 },
    "species": { "$ref": "#/$defs/factCat" },
    "body_type": { "$ref": "#/$defs/fact" },
    "primary_colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/fact" }
    },
    "pattern": { "$ref": "#/$defs/fact" },
    "ear_shape": { "$ref": "#/$defs/fact" },
    "eye_color": { "$ref": "#/$defs/fact" },
    "muzzle": { "$ref": "#/$defs/fact" },
    "tail": { "$ref": "#/$defs/fact" },
    "coat_length": { "$ref": "#/$defs/fact" },
    "accessories": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/fact" }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 64 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upload_id", "role"],
      "properties": {
        "upload_id": { "type": "string", "pattern": "^upl_[A-Za-z0-9_-]{8,64}$" },
        "role": { "enum": ["primary", "side", "detail"] }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "sources", "inferred"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 128 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sources": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/source" } },
        "inferred": { "type": "boolean" }
      }
    },
    "factCat": {
      "allOf": [
        { "$ref": "#/$defs/fact" },
        { "properties": { "value": { "const": "cat" } } }
      ]
    }
  }
}
