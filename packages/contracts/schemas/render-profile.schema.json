{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.epet.invalid/v2/render-profile.schema.json",
  "title": "Epet deterministic offline render profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "canvas", "supersampling", "pixel_format", "atlas_order", "png"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 256 },
        "height": { "const": 256 }
      }
    },
    "supersampling": { "type": "integer", "minimum": 1, "maximum": 4 },
    "pixel_format": { "const": "rgba8_srgb" },
    "atlas_order": { "const": "action_then_frame" },
    "png": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compress_level", "optimize"],
      "properties": {
        "compress_level": { "type": "integer", "minimum": 0, "maximum": 9 },
        "optimize": { "type": "boolean" }
      }
    }
  }
}
