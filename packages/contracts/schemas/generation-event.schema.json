{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.epet.invalid/v1/generation-event.schema.json",
  "title": "Generation state changed event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "job_id", "snapshot_version", "stage", "occurred_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "job_id": { "type": "string", "pattern": "^gen_[A-Za-z0-9_-]{8,64}$" },
    "snapshot_version": { "type": "integer", "minimum": 1 },
    "stage": {
      "enum": [
        "created",
        "validating",
        "generating_portrait",
        "awaiting_portrait_confirmation",
        "generating_actions",
        "postprocessing",
        "quality_check",
        "packaging",
        "ready",
        "cancel_requested",
        "failed",
        "canceled",
        "expired"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
