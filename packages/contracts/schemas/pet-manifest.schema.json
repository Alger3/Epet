{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.epet.invalid/v1/pet-manifest.schema.json",
  "title": "Epet pet package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_version",
    "min_runtime_version",
    "pet_id",
    "name",
    "species",
    "renderer",
    "created_at",
    "canvas",
    "atlas",
    "default_scale",
    "anchors",
    "hitboxes",
    "actions",
    "generation",
    "files"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "package_version": { "$ref": "#/$defs/semver" },
    "min_runtime_version": { "$ref": "#/$defs/semver" },
    "pet_id": { "type": "string", "pattern": "^pet_[A-Za-z0-9_-]{8,64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "species": { "enum": ["cat", "human"] },
    "subject_kind": { "enum": ["pet_cat", "human_avatar"] },
    "renderer": { "const": "sprite_atlas" },
    "created_at": { "type": "string", "format": "date-time" },
    "canvas": { "$ref": "#/$defs/size" },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "data", "max_texture_size"],
      "properties": {
        "image": { "$ref": "#/$defs/safePath" },
        "data": { "$ref": "#/$defs/safePath" },
        "max_texture_size": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "default_scale": { "type": "number", "minimum": 0.1, "maximum": 3 },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foot", "drag"],
      "properties": {
        "foot": { "$ref": "#/$defs/point" },
        "drag": { "$ref": "#/$defs/point" }
      }
    },
    "hitboxes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/hitbox" }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "required": ["idle"],
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,31}$" },
      "additionalProperties": { "$ref": "#/$defs/action" }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "rig", "clips", "render_profile"],
      "properties": {
        "layers": { "$ref": "#/$defs/safePath" },
        "rig": { "$ref": "#/$defs/safePath" },
        "clips": { "$ref": "#/$defs/safePath" },
        "render_profile": { "$ref": "#/$defs/safePath" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_version", "template_version"],
      "properties": {
        "pipeline_version": { "$ref": "#/$defs/semver" },
        "template_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 99,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._/-]+$"
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "hitbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "shape", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "shape": { "enum": ["rectangle", "ellipse"] },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "frame_duration_ms", "loop", "fallback"],
      "properties": {
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 240,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_[0-9]{3}$" }
        },
        "frame_duration_ms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 240,
          "items": { "type": "integer", "minimum": 16, "maximum": 10000 }
        },
        "loop": { "type": "boolean" },
        "next_action": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "fallback": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "phase_source": { "enum": ["time", "distance"] },
        "stride_length": { "type": "number", "exclusiveMinimum": 0, "maximum": 4096 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/safePath" },
            { "not": { "const": "manifest.json" } }
          ]
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 2 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["subject_kind", "animation"]
      }
    }
  ]
}
